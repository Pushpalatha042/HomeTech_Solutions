PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hometech
JWT_SECRET=your_secure_secret_key_here
CLIENT_URL=http://localhost:5173

# SMS Gateway Configuration
# Provider Option 1: Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# Provider Option 2: MSG91
# MSG91_AUTH_KEY=your_msg91_auth_key_here
# MSG91_TEMPLATE_ID=your_msg91_otp_template_id_here
# MSG91_SENDER_ID=HOMETC

# Provider Option 3: Generic SMS REST Gateway
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=HOMETC
# SMS_GATEWAY_URL=https://api.sms-provider.com/v1/send

# Gateway Simulation Mode (false in production)
DEV_OTP_MODE=false
